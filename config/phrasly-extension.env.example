# Backend wiring is Phase 3. Keep the existing retired proxy HTTP 410 rules.
PHRASLY_EXTENSION_ENABLED=false
PHRASLY_HANDOFF_SECRET=
PHRASLY_EXTENSION_ORIGIN=
# Public browser ID of the new extension; no manifest key or provider secret.
# Planned launcher binding for Phase 3/4, not consumed by the existing live launch path.
VITE_PHRASLY_EXTENSION_ID=
# Set the exact chrome-extension://<new-extension-ID> after a Phase 4 install.
# Use a fresh >=32-byte secret; do not reuse the AWS secret or copy sessions.
