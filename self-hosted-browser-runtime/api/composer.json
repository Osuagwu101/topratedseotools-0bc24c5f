{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "toprated/browser-runtime-api",
  "type": "project",
  "description": "Laravel control plane for the Top Rated self-hosted browser runtime.",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
