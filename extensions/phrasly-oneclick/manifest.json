{
  "manifest_version": 3,
  "name": "TopRated Phrasly OneClick — Staging",
  "version": "0.2.0",
  "description": "First-party handoff and usage relay. Does not distribute provider sessions.",
  "permissions": ["storage"],
  "host_permissions": ["https://topratedseotools.com/*"],
  "background": { "service_worker": "background.js" },
  "externally_connectable": { "matches": ["https://topratedseotools.com/*"] },
  "content_scripts": [
    { "matches": ["https://phrasly.ai/*"], "js": ["config.js", "content.js"], "run_at": "document_start" },
    { "matches": ["https://phrasly.ai/*"], "js": ["config.js", "interceptor.js"], "run_at": "document_start", "world": "MAIN" }
  ]
}
