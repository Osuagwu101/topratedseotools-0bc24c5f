{
  "manifest_version": 3,
  "name": "TopRated Claude Native Pilot",
  "version": "0.1.0",
  "description": "Super Admin-only native Claude launch test. Does not isolate shared Claude history.",
  "key": "",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://topratedseotools.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://topratedseotools.com/*"
    ]
  }
}
