{
  "manifest_version": 3,
  "name": "Jawad Ahmed EXR - Cookie Editor",
  "version": "1.0",
  "description": "A simple extension to view and edit cookies.",
  "permissions": [
    "cookies",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}