{
  "manifest_version": 3,
  "name": "Osuagwu Solomon TopRated",
  "version": "1.0.1",
  "minimum_chrome_version": "102",
  "description": "Copy your Phrasly cookies or send them to TopRated Admin to update a selected account.",
  "key": "",
  "permissions": [
    "cookies",
    "activeTab",
    "storage",
    "clipboardWrite",
    "alarms"
  ],
  "host_permissions": [
    "https://phrasly.ai/*",
    "https://*.phrasly.ai/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://topratedseotools.com/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Osuagwu Solomon TopRated",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
